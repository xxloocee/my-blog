---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE_CONFIG } from '~/lib/constants';

const friends = [
  {
    author: 'Yoci',
    org: 'Yoci\'s Blog',
    title: 'Yoci\'s Blog — AI、设计与写作的交汇处',
    url: 'https://yoci.cc',
    platform: '个人博客 · yoci.cc',
    pubDate: '2026-05-25',
    tags: ['AI', 'Web 设计', '写作', 'Liquid Glass'],
    summary: '一个注重细节的个人博客，涵盖 AI 探索、Web 设计实践、随笔写作、音乐与阅读笔记。最近在研究 Liquid Glass 折射效果，React + Framer Motion 技术栈，整体设计干净克制，值得逛逛。',
  },
  {
    author: 'shiqkuangsan',
    org: 'oh-my-daily-skills',
    title: 'Oh My Daily Skills — Claude Code 日常技能合集',
    url: 'https://github.com/shiqkuangsan/oh-my-daily-skills',
    platform: 'GitHub · oh-my-daily-skills',
    pubDate: '2026-05-25',
    tags: ['Claude Code', 'Skills', '效率工具', '开源'],
    summary: '遵循 Agent Skills Specification 的 Claude Code 公共技能集，包含 URL 阅读、Excalidraw 画图、单页幻灯片、Three.js 3D 场景、GitHub Star 整理、Neobrutalism 落地页等 12 个日常高频技能，支持 npx skills 一键安装，MIT 协议。',
  },
  {
    author: 'shiqkuangsan',
    org: 'Recopy',
    title: 'Recopy：一款免费、源码可见的跨平台剪贴板历史管理器',
    url: 'https://recopy.pages.dev',
    platform: '项目官网 · Recopy',
    pubDate: '2026-04-30',
    tags: ['效率工具', '剪贴板', 'Tauri'],
    summary: '如果你经常在文本、图片、文件和链接之间来回复制粘贴，Recopy 值得试试。它支持 macOS 和 Windows，提供剪贴板历史、全文检索、智能去重、快速预览和一键粘贴，更重要的是数据默认只保存在本地，产品边界清晰，适合把“复制”真正纳入日常工作流管理。',
  },
  {
    author: 'shiqkuangsan',
    org: 'antdv-next',
    title: '当 AI 能写完整个项目，我们还需要组件库吗？',
    url: 'https://mp.weixin.qq.com/s/-WDJzlHyMKFs22Ao0OjC3w',
    platform: '微信公众号 · Antdv Next',
    pubDate: '2026-03-27',
    tags: ['AI', '组件库', '前端'],
    summary: '从 Ant Design Vue 维护者的视角出发，探讨 AI 原生时代组件库的生存价值——代码生成只是冰山一角，API 契约、设计系统和品牌一致性才是不可替代的核心。',
  },
];
---

<BaseLayout title={`友链 | ${SITE_CONFIG.title}`} description="来自朋友们的优质文章推荐">
  <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2" style="font-family: 'Noto Serif SC', serif;">友链</h1>
      <p class="text-sm" style="color: var(--text-tertiary);">
        来自朋友们的优质文章推荐，每一篇都值得细读。
      </p>
    </div>
    <div class="space-y-4">
      {friends.map((friend) => (
        <a href={friend.url} target="_blank" rel="noopener noreferrer" class="neo-card neo-hover p-6 block" style="color: var(--text-primary);">
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <span class="text-xs" style="color: var(--text-tertiary);">
              {friend.pubDate}
            </span>
            <span class="neo-badge">{friend.platform}</span>
            <span class="text-xs" style="color: var(--text-secondary);">
              @{friend.author}
            </span>
          </div>
          <h2 class="text-xl font-bold mb-2">{friend.title}</h2>
          <p class="text-sm" style="color: var(--text-secondary);">
            {friend.summary}
          </p>
          {friend.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
              {friend.tags.map((tag) => (
                <span class="neo-tag">#{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
